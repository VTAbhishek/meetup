# Base URL of the PHP JSON API (XAMPP / Apache must be running).
# The backend now lives in the `backend/` folder.
VITE_API_BASE=http://localhost/meetup/backend/api

# Google Maps JavaScript API key, used by the business location picker and the
# map on the public company page. Create one at
# https://console.cloud.google.com/google/maps-apis/credentials and enable both
# "Maps JavaScript API" and "Places API" on the project.
# Restart `npm run dev` after changing this — Vite only reads .env at startup.
VITE_GOOGLE_MAPS_KEY=
